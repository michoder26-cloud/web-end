{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep enough production evidence to diagnose a failed checkout, move or integration
  // without sampling every trace on a growing customer site.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
  },
  // Runs scheduled automations. One trigger every 15 minutes covers every rule, so nobody has to touch this.
  // The free plan allows 5 cron triggers per account, and this site uses one.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-website",
      // The Deploy to Cloudflare button replaces this with your own new database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
